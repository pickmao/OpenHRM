FROM node:22-alpine AS build

WORKDIR /app

COPY ["干部动态调整系统前端/vue-project/package.json", "干部动态调整系统前端/vue-project/package-lock.json", "/app/"]
RUN npm ci

COPY ["干部动态调整系统前端/vue-project/", "/app/"]
RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ /usr/share/nginx/html/

EXPOSE 80
